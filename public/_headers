# Cloudflare Pages _headers configuration
# Configures security headers, caching, and iframe embedding compatibility

/*
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
  # Content Security Policy configured to allow embedding public government flood dashboards and weather resources
  Content-Security-Policy: default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; frame-src 'self' https: http:; img-src 'self' https: data: blob:; connect-src 'self' https: wss:; font-src 'self' https: data:; style-src 'self' 'unsafe-inline' https:;

# Cache static assets for fast global delivery via Cloudflare CDN
/assets/*
  Cache-Control: public, max-age=31536000, immutable
